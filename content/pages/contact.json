{
  "route": "/contact",
  "title": "Contact Us | RoboRingo",
  "description": "Get in touch with the RoboRingo team to learn how our AI receptionist and conversational phone agents can scale your call coverage.",
  "html": "<main id=\"main-content\" class=\"section company-page contact-page\">\n  <div class=\"company-grid company-contact\">\n    <div class=\"product-page-intro\">\n      <h1>Let\u2019s talk about your call coverage.</h1>\n      <p>Ask about the RoboRingo AI receptionist, discuss your team\u2019s needs, or arrange a custom demo.</p>\n      <section class=\"company-card contact-details\">\n        <img class=\"contact-symbol\" src=\"/assets/icons/platform-audio.svg\" alt=\"\" width=\"56\" height=\"42\"><h2>Start a conversation</h2>\n        <p><a href=\"mailto:sales@roboringo.com\">sales@roboringo.com</a></p>\n        <div class=\"contact-divider\"></div><h2>Find us in Gurugram</h2>\n        <address>RoboRingo Division<br>Plot 28\u201329, Electronic City, Phase IV, Udyog Vihar<br>Sector 18, Gurugram, Haryana 122001</address><a class=\"contact-map\" href=\"https://www.google.com/maps/search/?api=1&amp;query=Plot+28-29+Electronic+City+Udyog+Vihar+Gurugram\" target=\"_blank\" rel=\"noopener\">Open in Maps \u2197</a>\n      </section>\n    </div>\n    <form data-email-form=\"Contact Us enquiry\" method=\"post\" class=\"company-card contact-form\">\n      <h2>What can we help you with?</h2>\n      <p>Send us your details and our team will get back to you.</p>\n      <div class=\"contact-fields\"><label class=\"contact-wide\">I\u2019m interested in<select name=\"interest\"><option>AI calling for my business</option><option>Personal AI assistant</option><option>Training and security</option><option>Integrations and rollout</option><option>Something else</option></select></label>\n        <label>First name<input name=\"first\" autocomplete=\"given-name\" required></label>\n        <label>Last name<input name=\"last\" autocomplete=\"family-name\" required></label>\n        <label>Work email<input name=\"email\" type=\"email\" autocomplete=\"email\" required></label>\n        <label>Phone number<input name=\"phone\" type=\"tel\" autocomplete=\"tel\"></label>\n        <label class=\"contact-wide\">Company name<input name=\"company\" autocomplete=\"organization\"></label>\n        <label class=\"contact-wide\">How can we help?<textarea name=\"message\" rows=\"5\" required></textarea></label>\n      </div>\n      <button class=\"primary\" type=\"submit\">Send enquiry</button>\n    <div data-form-status role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></div><input type=\"text\" name=\"_honey\" class=\"form-honeypot\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\"></form>\n  </div>\n</main>",
